{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Finance Tracker",
  "version": "1.0.0",
  "identifier": "com.fintrack.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Finance Tracker",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["fintrack-api"],
    "resources": ["appsettings.json"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
